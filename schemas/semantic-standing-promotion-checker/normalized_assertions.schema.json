{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recomputableevidence.com/schemas/semantic-standing-promotion-checker/normalized_assertions.schema.json",
  "title": "FORK Semantic Standing Promotion Checker - Normalized Assertions v0.1.1 Repair",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_sha256", "normalization_provenance", "assertions"],
  "properties": {
    "source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "normalization_provenance": {"$ref": "#/$defs/normalization_provenance"},
    "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "subject_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "version", "sha256"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scope_coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_object_id", "dimension", "surface", "claim"],
      "properties": {
        "subject_object_id": {"type": "string", "minLength": 1},
        "dimension": {"type": "string", "minLength": 1},
        "surface": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1}
      }
    },
    "normalization_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalizer_id", "method", "authority", "coverage_status"],
      "properties": {
        "normalizer_id": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "authority": {"const": "DESCRIPTIVE_MAPPING_ONLY"},
        "coverage_status": {"enum": ["PARTIAL", "COMPLETE_CLAIMED", "UNKNOWN"]},
        "reviewer_ref": {"type": ["string", "null"]}
      }
    },
    "temporal_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source_class", "verification_status"],
      "properties": {
        "value": {"type": ["string", "null"], "format": "date-time"},
        "source_class": {"enum": ["EXPLICIT_SOURCE", "SOURCE_METADATA", "REVIEWER_SUPPLIED", "INFERRED", "ABSENT", "AMBIGUOUS"]},
        "verification_status": {"enum": ["VERIFIED", "UNVERIFIED", "UNKNOWN"]},
        "evidence_ref": {"type": ["string", "null"]}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "exact_text", "subject_identity", "transition_dimension", "asserted_state", "temporal_anchor", "scope"],
      "properties": {
        "assertion_id": {"type": "string", "minLength": 1},
        "exact_text": {
          "type": "string",
          "minLength": 1,
          "description": "Assertion text used for source containment after CRLF/LF canonicalization only. CRLF and LF are treated as equivalent for this comparison; lone CR is not normalized. This field does not establish byte-exact or code-point-exact containment. source_sha256 remains bound to the original unmodified source bytes."
        },
        "subject_identity": {"$ref": "#/$defs/subject_identity"},
        "transition_dimension": {"type": "string", "minLength": 1},
        "asserted_state": {"type": "string", "minLength": 1},
        "temporal_anchor": {"$ref": "#/$defs/temporal_anchor"},
        "scope": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scope_coordinate"}}
      }
    }
  }
}
