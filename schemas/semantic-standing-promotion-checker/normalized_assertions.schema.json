{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recomputableevidence.com/schemas/semantic-standing-promotion-checker/normalized_assertions.schema.json",
  "title": "FORK Semantic Standing Promotion Checker - Normalized Assertions",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_sha256", "assertions"],
  "properties": {
    "source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assertion"}
    }
  },
  "$defs": {
    "subject_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "version", "sha256"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "exact_text",
        "subject_identity",
        "transition_dimension",
        "asserted_state",
        "temporal_anchor",
        "scope"
      ],
      "properties": {
        "assertion_id": {"type": "string", "minLength": 1},
        "exact_text": {"type": "string", "minLength": 1},
        "subject_identity": {"$ref": "#/$defs/subject_identity"},
        "transition_dimension": {"type": "string", "minLength": 1},
        "asserted_state": {"type": "string", "minLength": 1},
        "temporal_anchor": {"type": "string", "format": "date-time"},
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "promotion_class_hint": {
          "enum": [
            "ESTABLISHMENT_PROMOTION",
            "CANONICALITY_PROMOTION",
            "VALIDATION_PROMOTION",
            "GENERALIZATION_PROMOTION",
            "AUTHORITY_PROMOTION",
            "CROSS_OBJECT_PROMOTION",
            "TEMPORAL_PROMOTION",
            "MATURITY_PROMOTION",
            "CONSEQUENCE_PROMOTION"
          ]
        }
      }
    }
  }
}
