{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recomputableevidence.com/schemas/semantic-standing-promotion-checker/evidence_registry.schema.json",
  "title": "FORK Semantic Standing Promotion Checker - Evidence Registry v0.1.1 Repair",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "evidence"],
  "properties": {
    "registry_id": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence_record"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "subject_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "version", "sha256"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "artifact", "path", "sha256", "role", "subject_identity", "status"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "artifact": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"type": "string", "minLength": 1},
        "subject_identity": {"$ref": "#/$defs/subject_identity"},
        "status": {"enum": ["PRESENT", "UNAVAILABLE", "SUPERSEDED", "UNKNOWN"]}
      }
    }
  }
}
