{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recomputableevidence.com/schemas/semantic-standing-promotion-checker/standing_envelope.schema.json",
  "title": "FORK Semantic Standing Promotion Checker - Standing Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope_id", "subjects"],
  "properties": {
    "envelope_id": {"type": "string", "minLength": 1},
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/subject"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "subject_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "version", "sha256"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "non_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "promotion_class"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "promotion_class": {
          "enum": [
            "ESTABLISHMENT_PROMOTION",
            "CANONICALITY_PROMOTION",
            "VALIDATION_PROMOTION",
            "GENERALIZATION_PROMOTION",
            "AUTHORITY_PROMOTION",
            "CROSS_OBJECT_PROMOTION",
            "TEMPORAL_PROMOTION",
            "MATURITY_PROMOTION",
            "CONSEQUENCE_PROMOTION"
          ]
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_state", "effective_from", "effective_until", "applies_to", "explicit_non_effects"],
      "properties": {
        "current_state": {"type": "string", "minLength": 1},
        "effective_from": {"type": "string", "format": "date-time"},
        "effective_until": {"type": ["string", "null"], "format": "date-time"},
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "explicit_non_effects": {
          "type": "array",
          "items": {"$ref": "#/$defs/non_effect"}
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_identity", "dimensions"],
      "properties": {
        "subject_identity": {"$ref": "#/$defs/subject_identity"},
        "dimensions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/dimension"}
        }
      }
    }
  }
}
