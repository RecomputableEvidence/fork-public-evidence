{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recomputableevidence.com/schemas/semantic-standing-promotion-checker/authorized_transitions.schema.json",
  "title": "FORK Semantic Standing Promotion Checker - Authorized Transition Registry",
  "type": "object",
  "required": ["registry_id", "transitions"],
  "additionalProperties": false,
  "properties": {
    "registry_id": {"type": "string", "minLength": 1},
    "transitions": {
      "type": "array",
      "items": {"$ref": "#/$defs/transition"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "subject_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "version", "sha256"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "transition_basis": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "MECHANICALLY_DERIVED",
            "AUTHORIZED_CONSTITUTIVE_ACT",
            "ADJUDICATED",
            "EXTERNALLY_OBSERVED",
            "CONTRACTUALLY_MATURED"
          ]
        },
        "authority_ref": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "premise_set_ref": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "MECHANICALLY_DERIVED"}}},
          "then": {"required": ["authority_ref", "rule_id", "premise_set_ref"]}
        },
        {
          "if": {"properties": {"type": {"enum": ["AUTHORIZED_CONSTITUTIVE_ACT", "ADJUDICATED"]}}},
          "then": {"required": ["authority_ref"]}
        }
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authorized_at"],
      "properties": {
        "status": {"enum": ["AUTHORIZED", "NOT_AUTHORIZED", "UNKNOWN"]},
        "authorized_at": {"type": "string", "format": "date-time"}
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["OCCURRED", "NOT_OCCURRED", "UNKNOWN"]},
        "occurred_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "effectivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "effective_from", "effective_until"],
      "properties": {
        "status": {"enum": ["EFFECTIVE", "NOT_EFFECTIVE", "TERMINATED", "UNKNOWN"]},
        "effective_from": {"type": "string", "format": "date-time"},
        "effective_until": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "artifact", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "artifact": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applies_to", "explicit_non_effects"],
      "properties": {
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "explicit_non_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "subject_identity",
        "transition_dimension",
        "transition_basis",
        "from_state",
        "to_state",
        "authorization",
        "occurrence",
        "effectivity",
        "evidence_bindings",
        "scope"
      ],
      "properties": {
        "transition_id": {"type": "string", "minLength": 1},
        "subject_identity": {"$ref": "#/$defs/subject_identity"},
        "transition_dimension": {"type": "string", "minLength": 1},
        "transition_basis": {"$ref": "#/$defs/transition_basis"},
        "from_state": {"type": "string", "minLength": 1},
        "to_state": {"type": "string", "minLength": 1},
        "authorization": {"$ref": "#/$defs/authorization"},
        "occurrence": {"$ref": "#/$defs/occurrence"},
        "effectivity": {"$ref": "#/$defs/effectivity"},
        "evidence_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_binding"}
        },
        "scope": {"$ref": "#/$defs/scope"}
      }
    }
  }
}
