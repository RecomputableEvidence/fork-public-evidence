{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fork.example/schemas/ghch_cadence_record_v0_1.schema.json",
  "title": "Governed Handoff Cadence Record v0.1",
  "description": "Descriptive structural envelope. Normative v0.1 semantics and exact key sets are executed by ghch_contract_v0_1.py and the semantic evaluator modules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "cadence_id",
    "profile",
    "canonicalization_profile",
    "participants",
    "claim_bundle",
    "exchange_policy",
    "non_claim_set",
    "events",
    "reconciliation",
    "declared_non_effects",
    "record_integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "artifact_type": {
      "const": "GHCH_CADENCE_RECORD"
    },
    "cadence_id": {
      "enum": [
        "GHCH-CAD-001",
        "GHCH-CAD-002",
        "GHCH-CAD-003"
      ]
    },
    "profile": {
      "enum": [
        "CLEAN_ROUND_TRIP",
        "PERMISSIBLE_NARROWING",
        "SIDECAR_UNAVAILABLE_FAIL_OPEN"
      ]
    },
    "canonicalization_profile": {
      "const": "GHCH-CANONICAL-JSON-v0.1"
    },
    "participants": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/participant"
      }
    },
    "claim_bundle": {
      "$ref": "#/$defs/digestBoundObject"
    },
    "exchange_policy": {
      "$ref": "#/$defs/digestBoundObject"
    },
    "non_claim_set": {
      "$ref": "#/$defs/digestBoundObject"
    },
    "events": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "reconciliation": {
      "type": "object"
    },
    "declared_non_effects": {
      "type": "object"
    },
    "record_integrity": {
      "$ref": "#/$defs/recordIntegrity"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "role",
        "authority_domain"
      ],
      "properties": {
        "participant_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "authority_domain": {
          "type": "string"
        }
      }
    },
    "digestBoundObject": {
      "type": "object",
      "required": [
        "canonicalization_profile",
        "canonical_sha256"
      ],
      "properties": {
        "canonicalization_profile": {
          "const": "GHCH-CANONICAL-JSON-v0.1"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "stage",
        "actor_id",
        "predecessor_ref",
        "claim_bundle_ref",
        "exchange_policy_ref",
        "non_claim_set_ref",
        "claim_delta",
        "local_effects",
        "observed_status",
        "detected_flags",
        "notes",
        "event_integrity"
      ],
      "properties": {
        "event_id": {
          "pattern": "^GHCH-EVT-[0-9]{3}$"
        },
        "stage": {
          "type": "string"
        },
        "actor_id": {
          "type": "string"
        },
        "predecessor_ref": {},
        "claim_bundle_ref": {
          "type": "object"
        },
        "exchange_policy_ref": {
          "type": "object"
        },
        "non_claim_set_ref": {
          "type": "object"
        },
        "claim_delta": {
          "type": "array"
        },
        "local_effects": {
          "type": "object"
        },
        "observed_status": {
          "type": "string"
        },
        "detected_flags": {
          "type": "object"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "event_integrity": {
          "type": "object"
        }
      }
    },
    "recordIntegrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization_profile",
        "canonical_record_sha256"
      ],
      "properties": {
        "canonicalization_profile": {
          "const": "GHCH-CANONICAL-JSON-v0.1"
        },
        "canonical_record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
