{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recomputableevidence.example/schemas/fork_self_standing_projection_v0_1_1.schema.json",
  "title": "Fork Self-Standing Projection v0.1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","record_kind","record_id","record_date","time_basis",
    "projection_observed_at","projection_nature","append_only",
    "repository_coordinate","predecessor_projection","claims","record_level_non_claims"
  ],
  "properties": {
    "schema_version": {"const": "v0.1.1"},
    "record_kind": {"const": "fork_self_standing_projection"},
    "record_id": {"type": "string","minLength": 1},
    "record_date": {"type": "string","pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "time_basis": {"type": "string","minLength": 1},
    "projection_observed_at": {"type": "string","minLength": 1},
    "projection_nature": {"const": "NON_AUTHORITATIVE_DERIVED_TEMPORAL_PROJECTION"},
    "append_only": {"const": true},
    "repository_coordinate": {"$ref": "#/$defs/repository_coordinate"},
    "predecessor_projection": {"$ref": "#/$defs/predecessor_projection"},
    "claims": {"type": "array","minItems": 1,"items": {"$ref": "#/$defs/claim"}},
    "record_level_non_claims": {"type": "array","minItems": 1,"items": {"type": "string","minLength": 1}}
  },
  "$defs": {
    "repository_coordinate": {
      "type": "object","additionalProperties": false,
      "required": ["repository","branch","commit_sha","tree_sha"],
      "properties": {
        "repository": {"const": "RecomputableEvidence/fork-public-evidence"},
        "branch": {"const": "preservation/clean-continuance-v0.1"},
        "commit_sha": {"type": "string","pattern": "^[0-9a-f]{40}$"},
        "tree_sha": {"type": "string","pattern": "^[0-9a-f]{40}$"}
      }
    },
    "predecessor_projection": {
      "type": "object","additionalProperties": false,
      "required": ["path","git_blob_sha","temporal_status","non_rewrite"],
      "properties": {
        "path": {"type": "string","minLength": 1},
        "git_blob_sha": {"type": "string","pattern": "^[0-9a-f]{40}$"},
        "temporal_status": {"const": "HISTORICAL_PREDECESSOR"},
        "non_rewrite": {"const": true}
      }
    },
    "evidence": {
      "type": "object","additionalProperties": false,
      "required": ["evidence_id","kind","relation","source","coordinate","digest","observed_at","clock_domain"],
      "properties": {
        "evidence_id": {"type": "string","minLength": 1},
        "kind": {"enum": [
          "GITHUB_API_OBSERVATION","GOVERNED_REPOSITORY_RECORD","EXECUTION_RECEIPT",
          "EXTERNAL_REVIEW","DERIVED_SUMMARY","CONVERSATIONAL_RECONSTRUCTION"
        ]},
        "relation": {"enum": ["DIRECT_SUPPORT","CONTEXT_ONLY","INTERPRETIVE_SOURCE"]},
        "source": {"type": "string","minLength": 1},
        "coordinate": {"type": ["string","null"]},
        "digest": {"type": ["string","null"]},
        "observed_at": {"type": "string","minLength": 1},
        "clock_domain": {"type": "string","minLength": 1}
      }
    },
    "interpretation": {
      "type": "object","additionalProperties": false,
      "required": ["present","kind","producer_class","method","source_evidence_ids"],
      "properties": {
        "present": {"type": "boolean"},
        "kind": {"enum": [
          "NONE","DERIVED_TEMPORAL_PROJECTION","BOUNDED_INFERENCE",
          "LENS_SHIFT_SYNTHESIS","GOVERNANCE_INTERPRETATION"
        ]},
        "producer_class": {"enum": ["NONE","AI_ASSISTED_AUTHORIAL_WORKFLOW","EXTERNAL_REVIEWER","GOVERNANCE_ACTOR"]},
        "method": {"type": ["string","null"]},
        "source_evidence_ids": {"type": "array","items": {"type": "string","minLength": 1}}
      }
    },
    "verification": {
      "type": "object","additionalProperties": false,
      "required": ["status","independent_verification_records"],
      "properties": {
        "status": {"enum": ["NOT_INDEPENDENTLY_VERIFIED","PARTIALLY_VERIFIED","INDEPENDENTLY_VERIFIED","NOT_APPLICABLE"]},
        "independent_verification_records": {"type": "array","items": {"type": "string","minLength": 1}}
      }
    },
    "independence_axis": {
      "type": "object","additionalProperties": false,
      "required": ["state","reference_class","evidence_ids"],
      "properties": {
        "state": {"enum": ["ESTABLISHED","PARTIAL","NOT_ESTABLISHED","NOT_APPLICABLE"]},
        "evidence_ids": {"type": "array","items": {"type": "string","minLength": 1}},
        "reference_class": {"type": "string","minLength": 1}
      }
    },
    "independence": {
      "type": "object","additionalProperties": false,
      "required": ["computational","artifact_acquisition","contextual_blinding","interpretive","institutional"],
      "properties": {
        "computational": {"$ref": "#/$defs/independence_axis"},
        "artifact_acquisition": {"$ref": "#/$defs/independence_axis"},
        "contextual_blinding": {"$ref": "#/$defs/independence_axis"},
        "interpretive": {"$ref": "#/$defs/independence_axis"},
        "institutional": {"$ref": "#/$defs/independence_axis"}
      }
    },
    "claim": {
      "type": "object","additionalProperties": false,
      "required": [
        "claim_id","subject","statement","finding_kind","temporal_status","historical_coordinate",
        "assertion_origin","standing_effect","evidence_provenance","interpretation_provenance",
        "verification","independence","limitations","non_claims"
      ],
      "properties": {
        "claim_id": {"type": "string","minLength": 1},
        "subject": {"type": "string","minLength": 1},
        "statement": {"type": "string","minLength": 1},
        "finding_kind": {"enum": ["OBSERVATION","DERIVED_STANDING","INFERENCE","HYPOTHESIS","GOVERNANCE_DISPOSITION"]},
        "temporal_status": {"enum": ["CURRENT_AT_NAMED_COORDINATE","HISTORICAL_ONLY"]},
        "historical_coordinate": {"type": ["string","null"]},
        "assertion_origin": {"enum": ["MECHANICALLY_OBSERVED","AUTHORIAL_OR_PROGRAMMATIC","EXTERNAL_REVIEWER","GOVERNANCE_DISPOSITION"]},
        "standing_effect": {"enum": ["OBSERVATION_ONLY_NO_STANDING_PROMOTION","HISTORICAL_ONLY","DERIVED_LIMITATION_ONLY","GOVERNANCE_EFFECT_EXPLICITLY_DECLARED"]},
        "evidence_provenance": {"type": "array","minItems": 1,"items": {"$ref": "#/$defs/evidence"}},
        "interpretation_provenance": {"$ref": "#/$defs/interpretation"},
        "verification": {"$ref": "#/$defs/verification"},
        "independence": {"$ref": "#/$defs/independence"},
        "limitations": {"type": "array","items": {"type": "string","minLength": 1}},
        "non_claims": {"type": "array","minItems": 1,"items": {"type": "string","minLength": 1}}
      }
    }
  }
}
