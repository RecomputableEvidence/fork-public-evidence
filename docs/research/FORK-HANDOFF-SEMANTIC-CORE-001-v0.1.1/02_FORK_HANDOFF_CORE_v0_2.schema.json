{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recomputableevidence.com/schemas/fork-handoff-core-v0.2.schema.json",
  "title": "Fork Handoff Semantic Core v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "record_identity",
    "subject",
    "claims",
    "non_claims",
    "authority_state",
    "unresolved",
    "revalidation_required",
    "evidence"
  ],
  "properties": {
    "schema_id": {
      "const": "FORK_HANDOFF_CORE_v0_2"
    },
    "record_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "created_at",
        "predecessor_record_id"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "predecessor_record_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "subject_type",
        "description"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_type": {
          "enum": [
            "ARTIFACT",
            "CLAIM_SET",
            "WORKFLOW_EVENT",
            "DECISION_RECORD",
            "MODEL_OUTPUT",
            "OTHER"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "non_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "TRUTH",
          "COMPLETENESS",
          "CORRECTNESS",
          "COMPLIANCE",
          "LEGAL_SUFFICIENCY",
          "AUTHORIZATION",
          "APPROVAL",
          "SAFETY",
          "PRODUCTION_READINESS",
          "ENDORSEMENT",
          "CERTIFICATION",
          "INDEPENDENT_WITNESSING",
          "CHRONOLOGY",
          "PROVENANCE_AUTHENTICITY"
        ]
      }
    },
    "authority_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transfer_status",
        "source_authority_ref",
        "target_authority_ref",
        "basis_evidence_refs"
      ],
      "properties": {
        "transfer_status": {
          "enum": [
            "NOT_TRANSFERRED",
            "TRANSFER_ASSERTED",
            "NOT_DETERMINED"
          ]
        },
        "source_authority_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_authority_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolved"
      }
    },
    "revalidation_required": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "TRUTH",
          "COMPLETENESS",
          "CORRECTNESS",
          "COMPLIANCE",
          "LEGAL_SUFFICIENCY",
          "AUTHORITY",
          "AUTHORIZATION",
          "APPROVAL",
          "SAFETY",
          "PRODUCTION_READINESS",
          "INDEPENDENT_WITNESSING",
          "CHRONOLOGY",
          "PROVENANCE_AUTHENTICITY",
          "SOURCE_CURRENCY"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_dimension",
        "statement",
        "scope",
        "claim_basis",
        "evidence_refs"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_dimension": {
          "enum": [
            "OBSERVATION",
            "STRUCTURAL_RESULT",
            "RECOMPUTATION_RESULT",
            "REVIEW_FINDING",
            "STATUS",
            "TRUTH",
            "COMPLETENESS",
            "CORRECTNESS",
            "COMPLIANCE",
            "LEGAL_SUFFICIENCY",
            "AUTHORIZATION",
            "APPROVAL",
            "SAFETY",
            "PRODUCTION_READINESS",
            "ENDORSEMENT",
            "CERTIFICATION",
            "INDEPENDENT_WITNESSING",
            "CHRONOLOGY",
            "PROVENANCE_AUTHENTICITY",
            "OTHER"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "claim_basis": {
          "enum": [
            "OBSERVED",
            "DECLARED",
            "RECOMPUTED",
            "REVIEWED",
            "DERIVED",
            "UNKNOWN"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unresolved_id",
        "dimension",
        "statement",
        "blocks"
      ],
      "properties": {
        "unresolved_id": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "enum": [
            "TRUTH",
            "COMPLETENESS",
            "CORRECTNESS",
            "COMPLIANCE",
            "LEGAL_SUFFICIENCY",
            "AUTHORITY",
            "AUTHORIZATION",
            "APPROVAL",
            "SAFETY",
            "PRODUCTION_READINESS",
            "INDEPENDENT_WITNESSING",
            "CHRONOLOGY",
            "PROVENANCE_AUTHENTICITY",
            "SOURCE_CURRENCY",
            "OTHER"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "description",
        "disclosure_state",
        "access_status",
        "locator"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "disclosure_state": {
          "enum": [
            "FULL",
            "REDACTED",
            "ENCRYPTED",
            "DIGEST_ONLY",
            "EXTERNAL_CONTROLLED",
            "UNAVAILABLE"
          ]
        },
        "access_status": {
          "enum": [
            "AVAILABLE",
            "RESTRICTED",
            "UNAVAILABLE",
            "UNKNOWN"
          ]
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
